Bootstrap: docker
# Pinned CUDA PyTorch runtime. If the cluster's driver is older than CUDA 12.4,
# pick a matching tag from https://hub.docker.com/r/pytorch/pytorch/tags.
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

%post
    pip install --no-cache-dir "numpy<3" scipy scikit-learn

%environment
    export PYTHONUNBUFFERED=1

%test
    python -c "import torch, sklearn, scipy; print('torch', torch.__version__, 'cuda', torch.version.cuda)"
